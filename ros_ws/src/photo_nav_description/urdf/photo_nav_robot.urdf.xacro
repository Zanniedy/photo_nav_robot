<?xml version="1.0"?>
<robot name="photo_nav_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PROPERTIES ==================== -->
  <!-- Chassis: cylinder, diameter 0.50m (radius 0.25m), height 1.65m -->
  <xacro:property name="chassis_radius"  value="0.25"/>
  <xacro:property name="chassis_height"  value="1.65"/>
  <xacro:property name="chassis_mass"    value="20.0"/>

  <!-- Drive wheels: radius 0.075m, width 0.05m -->
  <xacro:property name="wheel_radius"    value="0.075"/>
  <xacro:property name="wheel_width"     value="0.05"/>
  <xacro:property name="wheel_mass"      value="1.0"/>
  <!-- Wheels sit at the bottom of the chassis, z = wheel_radius from ground -->
  <!-- Chassis center z = wheel_radius + chassis_height/2 -->
  <xacro:property name="chassis_z"       value="${wheel_radius + chassis_height / 2.0}"/>

  <!-- Caster wheels: small sphere -->
  <xacro:property name="caster_radius"   value="0.03"/>
  <xacro:property name="caster_mass"     value="0.2"/>

  <!-- Sensor heights above ground -->
  <!-- Lidar at ~1.0m above ground -->
  <xacro:property name="lidar_z_from_ground"  value="0.8"/>
  <!-- Camera at ~1.8m above ground (lidar + 0.8m) -->
  <xacro:property name="camera_z_from_ground" value="1.5"/>

  <!-- ==================== MATERIALS ==================== -->
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.1 0.8 1.0"/>
  </material>

  <!-- ==================== INERTIA MACROS ==================== -->
  <xacro:macro name="inertial_cylinder" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0) * mass * (3 * radius*radius + length*length)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * mass * (3 * radius*radius + length*length)}"
        iyz="0.0"
        izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2.0/5.0) * mass * radius * radius}"
        ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0) * mass * radius * radius}"
        iyz="0.0"
        izz="${(2.0/5.0) * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <!-- ==================== CHASSIS ==================== -->
  <link name="base_link">
    <xacro:inertial_cylinder mass="${chassis_mass}" radius="${chassis_radius}" length="${chassis_height}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- chassis center is wheel_radius + chassis_height/2 above ground -->
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== DRIVE WHEELS (differential) ==================== -->
  <!--
    Wheels are placed at the equator of the chassis (z = 0 relative to base_link),
    symmetric on left/right, just outside the chassis radius.
    Wheel axis is along Y. Joint axis is (0 1 0).
  -->
  <xacro:macro name="drive_wheel" params="name y_reflect">
    <link name="${name}_wheel_link">
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
      <visual>
        <!-- cylinder along Z by default; rotate 90° around X so it rolls along X -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <!-- Side of chassis; at same height as chassis center minus chassis_z offset = ground level -->
      <origin xyz="0 ${y_reflect * (chassis_radius + wheel_width / 2.0)} ${-chassis_z + wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left"  y_reflect="1"/>
  <xacro:drive_wheel name="right" y_reflect="-1"/>

  <!-- ==================== CASTER WHEELS (omnidirectional) ==================== -->
  <!--
    Front and rear casters: small spheres that let the robot pivot freely.
    Placed at front (x = +chassis_radius * 0.8) and rear (x = -chassis_radius * 0.8),
    at ground level (z = caster_radius - chassis_z from base_link center).
  -->
  <xacro:macro name="caster_wheel" params="name x_pos">
    <link name="${name}_caster_link">
      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="light_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <!-- Near-zero friction so it acts as a free-rolling caster -->
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_caster_link"/>
      <origin xyz="${x_pos} 0 ${-chassis_z + caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel name="front" x_pos="${chassis_radius * 0.8}"/>
  <xacro:caster_wheel name="rear"  x_pos="${-chassis_radius * 0.8}"/>

  <!-- ==================== LIDAR (TF only, no plugin) ==================== -->
  <!--
    Single-line 2D lidar at ~1.0m above ground, mounted on the front face of the chassis.
    z offset from base_link: lidar_z_from_ground - chassis_z
  -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- On the front face of chassis, 1.0m above ground -->
    <origin xyz="${chassis_radius} 0 ${lidar_z_from_ground - chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CAMERA (TF only, no plugin) ==================== -->
  <!--
    Camera ~0.8m above the lidar (~1.8m above ground), also on the front face.
    z offset from base_link: camera_z_from_ground - chassis_z
  -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.10 0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.10 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <!-- On the front face of chassis, 1.8m above ground -->
    <origin xyz="${chassis_radius} 0 ${camera_z_from_ground - chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame for the camera (ROS convention: Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ==================== LIDAR SENSOR PLUGIN ==================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <!-- single-line: only 1 vertical channel -->
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== IGNITION GAZEBO PLUGINS ==================== -->
  <gazebo>
    <!-- Differential drive controller -->
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2.0 * (chassis_radius + wheel_width / 2.0)}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
    </plugin>

    <!-- Joint state publisher (publishes wheel joint states to /joint_states) -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Caster friction override in Gazebo -->
  <gazebo reference="front_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="rear_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>
