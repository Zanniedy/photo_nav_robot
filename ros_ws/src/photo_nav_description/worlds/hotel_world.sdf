<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hotel_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 30</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 30</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.6 0.6 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 封闭外墙 20x15m，墙高 2.5m，厚 0.2m ===== -->

    <!-- 南墙 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1</ambient><diffuse>0.82 0.80 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 北墙 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1</ambient><diffuse>0.82 0.80 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 西墙 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 15 2.5</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1</ambient><diffuse>0.82 0.80 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 东墙 -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 15 2.5</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1</ambient><diffuse>0.82 0.80 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 室内障碍物（增加激光雷达特征，避免空旷走廊退化）===== -->

    <!-- 立柱 x4，分布在四角内侧 -->
    <model name="pillar_nw">
      <static>true</static>
      <pose>-7 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_ne">
      <static>true</static>
      <pose>7 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_sw">
      <static>true</static>
      <pose>-7 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_se">
      <static>true</static>
      <pose>7 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 中央长桌 -->
    <model name="center_table">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 1.2 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.0 1.2 0.8</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 沙发组（西侧） -->
    <model name="sofa_w">
      <static>true</static>
      <pose>-7 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.7 2.0 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.7 2.0 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 沙发组（东侧） -->
    <model name="sofa_e">
      <static>true</static>
      <pose>7 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.7 2.0 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.7 2.0 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 前台柜台（北侧靠墙） -->
    <model name="reception_desk">
      <static>true</static>
      <pose>0 6.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.6 0.9</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.0 0.6 0.9</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
