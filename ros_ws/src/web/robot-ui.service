[Unit]
Description=Robot Debug UI (FastAPI + rosbridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/robot-debug-ui
ExecStart=/home/%i/robot-debug-ui/start.sh
Restart=on-failure
RestartSec=5
Environment=HOME=/home/%i

[Install]
WantedBy=multi-user.target
