Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 30
      Color: 160; 160; 164
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Alpha: 0.8
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Alpha: 0.3
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Alpha: 0.5
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 50; 50
      Decay Time: 0
      Value: true
    # 实机没有 robot_state_publisher，用 costmap 发布的 footprint 代替 RobotModel
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 0; 255; 0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 0; 0; 255
      Line Style: Billboards
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 0; 200; 255
      Line Style: Billboards
      Line Width: 0.02
      Value: true
    - Class: rviz_default_plugins/Path
      Name: EKF Path
      Topic:
        Value: /lio_ekf_path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 0; 200; 0
      Line Width: 0.02
      Value: false
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Topic:
        Value: /particle_cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Shape: Arrow (Flat)
      Color: 255; 150; 0
      Arrow Length: 0.15
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Pose
      Topic:
        Value: /amcl_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Shape: Arrow
      Color: 255; 25; 255
      Covariance:
        Value: true
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Localizer Pose
      Topic:
        Value: /localizer/pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Shape: Arrow
      Color: 0; 255; 255
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    # 发到 relocalize_node 做扫描精配，由它转发 /initialpose 给 AMCL
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose_rough
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      # 地图 x 轴 = 建图起点车头方向，和房间实际方位差 90°，视角顺时针转 90° 对齐实际
      Angle: 1.5708
      Scale: 40
      X: 0
      Y: 0
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
