<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>led_display</name>
  <version>0.1.0</version>
  <description>LEDCanvas 16x32 蓝牙 LED 软屏：协议库 + 命令行 + ROS 节点（文字 / GIF / 亮度 / 开关）</description>
  <maintainer email="liukeyerror@outlook.com">Zanniedy</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <!-- bleak 不在 rosdep 里，要用 pip 单独装，命令见 HANDOFF -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
